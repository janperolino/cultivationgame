{
  "name": "severed-heaven",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "tsx sim/run.ts",
    "atlas:build": "tsx tools/atlas-build.ts",
    "atlas:serve": "node tools/atlas-serve.cjs",
    "art": "tsx tools/art.ts",
    "sound": "tsx tools/sound.ts",
    "sound:find": "tsx tools/sound-find.ts",
    "sound:pick": "tsx tools/sound-pick.ts",
    "spike": "node --env-file=.env.local --import tsx sim/spike.ts",
    "glm": "node --env-file=.env.local --import tsx sim/glm.ts",
    "goin": "node --env-file=.env.local --import tsx sim/goin.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "d3": "^7.9.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "onnxruntime-node": "^1.30.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
